--- a/vllm/v1/attention/backends/mla/indexer.py
+++ b/vllm/v1/attention/backends/mla/indexer.py
@@ -833,7 +833,17 @@ def get_max_prefill_buffer_size(vllm_config: VllmConfig):
     # within the flashmla_sparse workspace.
     # For DeepSeek-V3.2, the max_model_len is 163840.
     #   40 * 163840 * 132 = 865075200 bytes = 825 MB
-    return max_model_len * 40
+    # VLLM_INDEXER_PREFILL_BUFFER_FACTOR (default 40 = unchanged) lowers it
+    # for models whose indexer cache is pooled (GLM-5.3-Flash: index_kpool = 4,
+    # so one request needs at most max_model_len / 4 entries; the 40x reservation
+    # costs ~0.5 GiB/card of KV pool at 131k on 24 GB cards).
+    # _split_indexer_prefill_chunks keeps multi-request chunks within this size.
+    # Keep factor * max_model_len * 132 B >= the fused-MoE buffers that share this
+    # workspace (128 MiB on GLM-5.3-Flash TP8): smaller makes the MoE resize it,
+    # which MEASURED cost 0.17 GiB of pool (factor 2: 0.63 GiB, factor 8: 1.0).
+    import os
+    factor = int(os.environ.get("VLLM_INDEXER_PREFILL_BUFFER_FACTOR", "40"))
+    return max_model_len * factor
 
 
